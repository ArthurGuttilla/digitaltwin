# ─── Tropicalia ──────────────────────────────────────────────────────────────
# Your API key from tropicalia.dev
TROPICALIA_API_KEY=your_tropicalia_api_key_here

# Override base URL if self-hosting Tropicalia
# TROPICALIA_BASE_URL=https://api.tropicalia.dev

# ─── Claude / Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Social Platforms ────────────────────────────────────────────────────────
# Twitter API v2 Bearer Token (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# YouTube Data API v3 key (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram Graph API long-lived access token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
